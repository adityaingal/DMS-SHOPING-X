# ===== ShopX environment configuration =====
# Copy this file to ".env" and adjust the values.
# Never commit the real .env file to version control.
# For production, set these in the Render dashboard instead - see DEPLOY_RENDER.md.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection (local MongoDB Community Server or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/shopx
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shopx?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cookies
# Local development: COOKIE_SECURE=false (http://localhost)
# Production (Render): COOKIE_SECURE=true and COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google Sign-In (OAuth 2.0 Web client ID - public identifier, safe to expose)
# Create it in Google Cloud Console -> APIs & Services -> Credentials.
# See GOOGLE_LOGIN_SETUP.md for the full step-by-step guide.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# CORS - comma separated list of trusted origins ("*" allowed for local dev)
# Production: set to your Render URL, e.g. https://your-shopx-service.onrender.com
CORS_ORIGIN=http://localhost:5000

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Limits for /api/auth/* endpoints (login, signup, Google sign-in)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Public URL of the app. Used for links inside Discord/email notifications.
# Production: set to your Render URL (no trailing slash).
APP_URL=http://localhost:5000

# Admin bootstrap (used by npm run create-admin / npm run seed)
ADMIN_EMAIL=admin@shopx.com
ADMIN_PASSWORD=Admin@123

# Frontend + uploads
FRONTEND_DIR=../frontend
STORE_NAME=ShopX

# ===== Order notifications =====
# Discord (server-side only — never exposed to the browser)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/YOUR_WEBHOOK_TOKEN_HERE
DISCORD_NOTIFICATIONS_ENABLED=true

# Gmail SMTP — use an App Password, never your normal Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Store owner notification inbox + customer confirmation toggle
ORDER_NOTIFICATION_EMAIL=
CUSTOMER_EMAIL_NOTIFICATIONS_ENABLED=false
STORE_TIMEZONE=Asia/Kolkata

# Notification queue tuning (optional)
NOTIFICATION_POLL_MS=3000
NOTIFICATION_MAX_ATTEMPTS=5
